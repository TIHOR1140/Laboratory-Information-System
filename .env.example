# Express Server Configuration
PORT=4000
CLIENT_URL=http://localhost:5173

# Native Local PostgreSQL Connection Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lis_db
DB_USER=postgres
DB_PASSWORD=root
DATABASE_URL=postgresql://postgres:root@localhost:5432/lis_db

# Authentication & Security
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
